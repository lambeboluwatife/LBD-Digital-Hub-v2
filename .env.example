# ==============================================================================
# LBD Digital Hub - Environment Variables Template
# Copy this file to .env.local and fill in your values
# ==============================================================================

# Resend API Key for sending emails from the contact form
# Obtain an API key by signing up at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Recipient email address for contact form submissions (default: boluwatifelambe@gmail.com)
CONTACT_EMAIL=boluwatifelambe@gmail.com

# Verified sender email address
# Free tier testing domain: "LBD Contact Form <onboarding@resend.dev>"
# Production (with custom verified domain): "LBD Digital Hub <contact@lbddigitalhub.com>"
RESEND_FROM_EMAIL=LBD Contact Form <onboarding@resend.dev>

# Base URL of the website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email address displayed on the client
NEXT_PUBLIC_EMAIL=boluwatifelambe@gmail.com